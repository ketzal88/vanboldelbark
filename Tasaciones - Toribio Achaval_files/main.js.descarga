 $("#enviar_form_detalle_promo").click(function () {
    var pattern = $("#enviar_form_detalle_promo").closest(".form");
    var nombre = $("#frm_name").val() || "";
    var email = $("#frm_email").val();
    var telefono = $("#frm_telefono").val() || "";
    var tipo_form = $("#frm_tipo").val();
    var comentario = $("#frm_comentario").val() || "";
    var apellido = $("#frm_apellido").val() || "";
    var id_promocion = $("#frm_promocion").val() || 0;
    var id_contacto = $("#frm_contacto").val() || 0;
    var mail_contacto = $("#frm_mail_contacto").val() || "";
    var contactar_por = $("#frm_contactar_por").val() || "";

    var url_gracias = $("#frm_url_gracias").val() || "";
    var btn = pattern.find(".btn");

    if (id_promocion == 0) {
      showNotice("La promoción no es válida", "", "yellow");
      return false;
    }
    if (email == "") {
      showNotice("El campo Email es obligatorio", "", "yellow");
      return false;
    }
    if (echeck(email) == false) {
      showNotice("Ingrese un email válido", "", "yellow");
      return false;
    }
    if (id_promocion != 1158) {
      if (nombre == "") {
        showNotice("El campo Nombre es obligatorio", "", "yellow");
        return false;
      }
      if (apellido == "") {
        showNotice("El campo Apellido es obligatorio", "", "yellow");
        return false;
      }

      if (telefono == "") {
        showNotice("El campo Teléfono es obligatorio", "", "yellow");
        return false;
      }

      if (contactar_por == "") {
        showNotice("El campo Contactar por es obligatorio", "", "yellow");
        return false;
      } else if (contactar_por == "contacto_por") {
        contactar_por = "";
      }

      if (comentario == "") {
        showNotice("El campo Comentario es obligatorio", "", "yellow");
        return false;
      }

    }

     dataLayer.push({
            "event": "form_submit",
            "email": email,
            "phone_number": telefono,
            "_tag_mode": "MANUAL"

        });

    $(".toast").fadeOut("slow");

    addLoader(btn);
    $.ajaxSetup({
        headers: {
            'X-CSRF-TOKEN': $('input[name="_token"]').val()
        }
    });
    $.ajax({
      type: "POST",
      url: "/formulario/promocion",

      data:
      "_token=" + $('input[name="_token"]').val() +
        "&nombre=" +
        nombre +
        "&apellido=" +
        apellido +
        "&email=" +
        email +
        "&telefono=" +
        telefono +
        "&consulta=" +
        comentario +
        "&promocion_id=" +
        id_promocion +
        "&id_contacto=" +
        id_contacto +
        "&mail_contacto=" +
        mail_contacto +
        "&contactar_por=" +
        contactar_por,
      success: function (html) {
        if (html == "OK") {
          if (url_gracias != "") {
            $("#frm_name").val("");
            $("#frm_email").val("");
            $("#frm_telefono").val("");
            $("#frm_comentario").val("");
            window.location = url_gracias;
          } else {
            showNotice(
              "Mensaje enviado",
              "Su mensaje ha sido enviado correctamente",
              "green"
            );
            btn.removeClass("sending").html("Enviar");
            $("#frm_name").val("");
            $("#frm_email").val("");
            $("#frm_telefono").val("");
            $("#frm_comentario").val("");
          }
        }
      },
    });
    return false;
  });

$("#enviar_form_detalle_ta_mob").click(function () {
    EnviarDatosForm("_mob");

});

function EnviarDatosForm(from = '') {
        var pattern = $("#enviar_form_detalle_ta" + from).closest(".form");
        var nombre = pattern.find("#frm_name"  + from).val();
        console.log(nombre);
        var apellido =  pattern.find('#frm_apellido'  + from).val()??'';
        var email = pattern.find("#frm_email" + from).val();
        var telefono = pattern.find("#frm_telefono" + from).val();
        var tipo_form = $("#frm_tipo").val()??'';
        var comentario = pattern.find("#frm_comentario"  + from).val() || "";
        var email_sucursal = $("#frm_email_sucursal").val();
        var propiedad_id = $("#frm_propiedad_id_email").val() || 0;
        var contenedora_id = $("#frm_contenedora_id_email").val() || 0;
        var tipo_propiedad = $("#frm_tipo_propiedad").val() || "";
        var tipo_operacion = $("#frm_operacion").val() || "";
        var barrio = $("#frm_barrio").val() || "";
        var source = $("#frm_source").val() || "";
        var url_gracias = $("#frm_url_gracias").val() || "";
        var id_sucursal = $("#frm_id_sucursal").val() || "";
        var btn = pattern.find(".btn");

        if (nombre == "") {
            showNotice("El campo Nombre y Apellido es obligatorio", "", "yellow");
            return false;
        }

        if (email == "") {
            showNotice("El campo Email es obligatorio", "", "yellow");
            return false;
        }
        if (echeck(email) == false) {
            showNotice("Ingrese un email válido", "", "yellow");
            return false;
        }

        if (telefono == "") {
            showNotice("El campo Teléfono es obligatorio", "", "yellow");
            return false;
        }

        if (tipo_form == "tasaciones_residenciales") {
            if (barrio == "") {
                showNotice("El campo Barrio es obligatorio", "", "yellow");
                return false;
            }
            if (tipo_propiedad == "") {
                showNotice("El campo Tipo de Propiedad es obligatorio", "", "yellow");
                return false;
            }
            comentario = "Barrio: " + barrio + " - Tipo de Propiedad: " + tipo_propiedad + "<br><br>" + comentario;
        }
        if (tipo_form == "busquedas_residenciales") {
            if (tipo_operacion == "") {
                showNotice("El Tipo de Operación es obligatorio", "", "yellow");
                return false;
            }
            comentario = "Tipo de Operación: " + tipo_operacion + "<br><br>" + comentario;
        }

        dataLayer.push({
            "event": "form_submit",
            "email": email,
            "phone_number": telefono,
            "_tag_mode": "MANUAL"

        });
        //ga('send', 'event', 'submit', email, telefono);


        $(".toast").fadeOut("slow");

        addLoader(btn);

        $.ajaxSetup({
            headers: {
                'X-CSRF-TOKEN': $('input[name="_token"]').val()
            }
        });

        $.ajax({
            type: "POST",
            url: "/formulario/detalle",

            data:
                "_token=" + $('input[name="_token"]').val() +
                "&nombre=" + nombre +
                "&tipo_form=" + tipo_form +
                "&email=" + email +
                "&telefono=" + telefono +
                "&consulta=" + comentario +
                "&email_sucursal=" + email_sucursal +
                "&propiedad_id=" + propiedad_id +
                "&contenedora_id=" + contenedora_id +
                "&id_sucursal=" + id_sucursal +
                "&apellido=" + apellido +
                "&source=" + source,
            success: function (html) {
                if (html == "OK") {
                if (url_gracias != "") {
                    $("#frm_name").val("");
                    $("#frm_email").val("");
                    $("#frm_telefono").val("");
                    $("#frm_comentario").val("");
                    window.location =  url_gracias;
                } else {
                    showNotice("Mensaje enviado", "Su mensaje ha sido enviado correctamente", "green");
                    btn.removeClass("sending").html("Enviar");
                    $("#frm_name").val("");
                    $("#frm_email").val("");
                    $("#frm_telefono").val("");
                    $("#frm_comentario").val("");
                }
                }
            },
        });
}

$("#enviar_form_detalle_ta").click(function () {
      EnviarDatosForm("");
      return false;
});
jQuery(".toast__close").click(function (e) {
    e.preventDefault();
    var parent = $(this).parent(".toast");
    parent.fadeOut("slow");
  });


if ($(".page-template-template-detalle_propiedades").length > 0) {
    // get tallest tab__content element
    var height = -1;

    $(".tab__content").each(function () {
      height = height > $(this).outerHeight() ? height : $(this).outerHeight();
      $(this).css("position", "absolute");
    });

    // set height of tabs + top offset
    $("[data-tabs]").css("min-height", height + "px");
    $(".tabs").addClass("ready");
    if ($("#hasMap").val() == 1) {
      initMapTabs();
    }

    $(document).on("click", 'a[href^="#"]', function (event) {
      event.preventDefault();
      var nav = $($.attr(this, "href"));
      if (nav.length) {
        $("html, body").animate(
          {
            scrollTop: $($.attr(this, "href")).offset().top,
          },
          500
        );
      }
    });

    var screen = $(window).height();
    var screenBottom = $(window).scrollTop() + screen;
    var barTop = 0;// $("#galeria .bar-top").offset().top;
    var offsetBarTop = $("#content_").offset().top + 64;

    if (screen <= barTop && screenBottom <= offsetBarTop) {
      $("#galeria").addClass("scroll");
    }

    $(window).on("scroll", function () {
      !window.requestAnimationFrame
        ? fixSearch()
        : window.requestAnimationFrame(fixSearch);
    });

    function fixSearch() {
      var offsetContact = $("#sticky-sidebar").offset().top + 400;
      var screenBottom = $(window).scrollTop() + screen;
      var offsetBarTop = $("#content_").offset().top - 40;
      var offsetTop = $("#galeria").offset().top,
        scrollTop = $(window).scrollTop();
      scrollTop >= offsetTop
        ? $("#searchbox").addClass("scroll_gallery")
        : $("#searchbox").removeClass("scroll_gallery");
      scrollTop >= offsetTop
        ? $("#search_float").addClass("right-bar")
        : $("#search_float").removeClass("right-bar");
      scrollTop >= offsetTop && scrollTop <= offsetContact
        ? $("#contact-float").addClass("active")
        : $("#contact-float").removeClass("active");

      screenBottom <= offsetBarTop
        ? $("#galeria").addClass("scroll")
        : $("#galeria").removeClass("scroll");
    }
  }





  $("#enviar_form_acreditaciones").click(function () {
    var pattern = $("#enviar_form_detalle_ta").closest(".form");
    var nombre = $("#frm_name").val();
    var email = $("#frm_email").val();
    var telefono = $("#frm_telefono").val();
    var tipo_form = $("#frm_tipo").val();
    var dni = $("#frm_dni").val() ?? "";
    var apellido = $("#frm_apellido").val() || "";
    var id_promocion = $("#frm_promocion").val() || 0;
    var asistire_con = $("#asistire_con").val() || "";
    var tipo_contacto_id = $("#tipo_contacto_id").val() || 0;
    var tipocontacto_otro = $("#tipocontacto_otro").val() || "";
    var mail_contacto = $("#frm_mail_contacto").val() || "";
    var url_gracias = $("#frm_url_gracias").val() || "";
    var tipo_promocion_id = $("#frm_tipo_promocion").val() || "0";
    var btn = pattern.find(".btn");

    if (id_promocion == 0) {
      showNotice("La promoción no es válida", "", "yellow");
      return false;
    }
    if (tipo_promocion_id != 2 && tipo_promocion_id != 4) {
      showNotice("La promoción no es válida", "", "yellow");
      return false;
    }
    if (tipo_form != "acreditaciones") {
      showNotice("El formulario no es válido", "", "yellow");
      return false;
    }
    if (nombre == "") {
      showNotice("El campo Nombre es obligatorio", "", "yellow");
      return false;
    }
    if (apellido == "") {
      showNotice("El campo Apellido es obligatorio", "", "yellow");
      return false;
    }
    if (email == "") {
      showNotice("El campo Email es obligatorio", "", "yellow");
      return false;
    }
    if (echeck(email) == false) {
      showNotice("Ingrese un email válido", "", "yellow");
      return false;
    }
    if (telefono == "") {
      showNotice("El campo Teléfono es obligatorio", "", "yellow");
      return false;
    }

    if (tipo_promocion_id == 2) {
      /*if(dni == ''){
                showNotice('El campo DNI es obligatorio', '', 'yellow');
                return false;
            }
            if(asistire_con == ''){
                showNotice('El campo Asistiré con es obligatorio', '','yellow');
                return false;
            }*/

      /*  if(tipo_contacto_id == '' || tipo_contacto_id == "0"){
                showNotice('El campo "Comó se enteró del proyecto?" con es obligatorio', '','yellow');
                return false;
            }*/
      if (tipo_contacto_id == "8" && tipocontacto_otro == "") {
        showNotice(
          "Si seleccionó Otro en la forma que senteró del proyeto, debe ingresar cual",
          "",
          "yellow"
        );
        return false;
      }
    }

    $(".toast").fadeOut("slow");

    addLoader(btn);

    $.ajax({
      type: "POST",
      url:  "/formulario/",

      data:
        "tipo=form_acreditacion&nombre=" +
        nombre +
        "&apellido=" +
        apellido +
        "&email=" +
        email +
        "&telefono=" +
        telefono +
        "&dni=" +
        dni +
        "&promocion_id=" +
        id_promocion +
        "&asistire_con=" +
        asistire_con +
        "&tipo_contacto_id=" +
        tipo_contacto_id +
        "&tipocontacto_otro=" +
        tipocontacto_otro,
      success: function (html) {
        if (html == "OK") {
          if (url_gracias != "") {
            $("#frm_name").val("");
            $("#frm_email").val("");
            $("#frm_telefono").val("");
            $("#frm_dni").val("");
            $("#asistire_con").val("");
            $("#frm_apellido").val("");
            $("#tipo_contacto_id").val("");
            $("#tipocontacto_otro").val("");
            window.location =  url_gracias;
          } else {
            showNotice(
              "Mensaje enviado",
              "Su mensaje ha sido enviado correctamente",
              "green"
            );
            btn.removeClass("sending").html("Enviar");
            $("#frm_name").val("");
            $("#frm_email").val("");
            $("#frm_telefono").val("");
            $("#frm_dni").val("");
            $("#asistire_con").val("");
            $("#frm_apellido").val("");
            $("#tipo_contacto_id").val("");
            $("#tipocontacto_otro").val("");
          }
        }
      },
    });
    return false;
  });



  //form contacto
  $("#enviar_form_contacto").click(function () {
    var pattern = $("#enviar_form_contacto").closest(".form");
    var nombre = pattern.find("input[name=name]");
    var email = pattern.find("input[name=email]");
    var telefono = pattern.find("input[name=telefono]");
    var comentario = pattern.find("#comentario");
    var term = pattern.find("#term");
    var btn = pattern.find(".btn");

    //console.log(term);
    //console.log(term.val())

    if (nombre.val() == "") {
      showNotice("El campo Nombre y Apellido es obligatorio", "", "yellow");
      return false;
    }

    if (email.val() == "") {
      showNotice("El campo Email es obligatorio", "", "yellow");
      return false;
    }

    if (echeck(email.val()) == false) {
      showNotice("Ingrese un email válido", "", "yellow");
      return false;
    }

    if (telefono.val() == "") {
      showNotice("El campo Teléfono es obligatorio", "", "yellow");
      return false;
    }

    $(".toast").fadeOut("slow");

    addLoader(btn);

    setTimeout(function () {
      $.ajax({
        type: "POST",
        url:  "/formulario",

        data:
          "tipo=form_1&nombre=" +
          nombre.val() +
          "&email=" +
          email.val() +
          "&telefono=" +
          telefono.val() +
          "&consulta=" +
          comentario.val() +
          "&term=" +
          term.val(),
        success: function (html) {
          if (html == "ok") {
            showNotice("Mensaje enviado con éxito", "", "green");
            addLoaderEnd(btn);
            nombre.val("");
            email.val("");
            telefono.val("");
            comentario.val("");
          } else {
            showNotice(
              "Error inesperado",
              "Por favor intente en otro momento",
              "red"
            );
          }
        },
      });
    }, 1000);

    return false;
  });

