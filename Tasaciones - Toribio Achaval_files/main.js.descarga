// Subir CV
if ($(".dropzone").length > 0) {
  Dropzone.options.myAwesomeDropzone = {
    dictDefaultMessage: "Subir CV",
    maxFiles: 1,
    // acceptedFiles: '.jpg,.png,.gif',
    acceptedFiles: ".pdf,.doc,.docx",
    init: function () {
      this.on("success", function (a, b) {
        $("#imagen").val(b);
        $(".adjunto-icon").fadeOut("fast", function () {
          $(".dz-details").show();
        });
      });
      this.on("processing", function () {
        $(".dz-default.dz-message").fadeOut("fast", function () {
          $(".adjunto-icon").css("opacity", "1");
        });
      });
    },
  };
}

$(document).ready(function () {
    $("#news_go").click(function (e) {
        e.stopPropagation();
        var email = $("#newsletter #email_news");
        var btn = $("#news_go");

        if (email.val() == "") {
            email.focus();
            showNotice("Es obligatorio ingresar un email", "", "yellow");
            return false;
        }

        if (echeck(email.val()) == false) {
            email.focus();
            showNotice("El email ingresado no es válido", "", "yellow");
            return false;
        }

        $(".toast").fadeOut("slow");
        addLoader(btn);
        $.ajaxSetup({
            headers: {
                'X-CSRF-TOKEN': $('input[name="_token"]').val()
            }
        });
        setTimeout(function () {
        $.ajax({
            type: "POST",
            url:  "/formulario/newsletter",
            data: "email=" + email.val() + "&_token=" + $('input[name="_token"]').val(),
            success: function (html) {
                if (html == "ok") {
                    $("#newsletter").addClass("sending");
                    $("#newsletter .input-search-wrapper").fadeOut();
                    $("#newsletter .container strong").html(
                    "¡Gracias!<br> Muy pronto comenzarás a recibir todas nuestras novedades."
                    );
                }

                if (html == "ya-existe") {
                    showNotice("Su email ya se encuentra registrado", "", "yellow");
                    $("#newsletter").removeClass("sending");
                    btn
                    .removeClass("sending")
                    .html('<span>SUSCRIBIR</span><i class="fa fa-angle-right"></i>');
                }
            },
        });
        }, 500);
  });

  //open sub menu mobile
  $(".sub-menu > a").click(function () {
    $(this).parent(".sub-menu").children(".menu-content").slideToggle("200");
    $(this).find("i.fa").toggleClass("fa-angle-up fa-angle-down");
  });

  //swiper

  if ($("#resultados_propiedades")) {
    var swiper = new Swiper("#resultados_propiedades .swiper-container", {
      navigation: {
        nextEl: "#resultados_propiedades .swiper-button-next",
        prevEl: "#resultados_propiedades .swiper-button-prev",
      },
    });
  }

  $("#search_float").click(function () {
    if ($(this).hasClass("open")) {
      $("#searchbox,#search_float")
        .removeClass("active")
        .addClass("close")
        .removeClass("open");
      $("#search_float i").removeClass("fa-close").addClass("fa-search");
    } else {
      $("#searchbox,#search_float")
        .addClass("active")
        .addClass("open")
        .removeClass("close");
      $("#search_float i").removeClass("fa-search").addClass("fa-close");
    }
  });

