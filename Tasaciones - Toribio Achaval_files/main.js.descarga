        }
        url = JSONtoQuerystring(url);
        url = parseUrlAPI(url);

        if(flag){
            url = url + '&precio=' + string_precio
        }*/
    addLoader(btn);
    utmvalue = $("#utmvalues").val() ?? "";
    if (!urlstring.endsWith("/")) {
      urlstring += "/";
    }
    window.location.replace(
      urlstring + "precio_" + string_precio + "/" + utmvalue
    );

    return false;
  });

