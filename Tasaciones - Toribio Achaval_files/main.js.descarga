  function triggerFilter($bool) {
    var elementsToTrigger = $([
      $(".cd-filter-trigger"),
      $(".cd-filter"),
      $(".cd-tab-filter"),
      $(".cd-gallery"),
      $("#filters"),
    ]);
    elementsToTrigger.each(function () {
      $(this).toggleClass("filter-is-visible", $bool);
    });
  }

  if ($("#resultados_propiedades").length > 0) {
    //fix lateral filter and gallery on scrolling
    $(window).on("scroll", function () {
      !window.requestAnimationFrame
        ? fixGallery()
        : window.requestAnimationFrame(fixGallery);
    });

    function fixGallery() {
      var offsetTop = $("#resultados_propiedades").offset().top,
        scrollTop = $(window).scrollTop();
      scrollTop >= offsetTop
        ? $("#content-main").addClass("is-fixed")
        : $("#content-main").removeClass("is-fixed");
    }
  }

  //SELECTS + LÓGICA
  $(".sel").each(function () {
    var $current = $(this);

    $(this)
      .find("option")
      .each(function (i) {
        if (i == 0) {
          $current.prepend(
            $("<div>", {
              class: $current.attr("class").replace(/sel/g, "sel__box"),
            })
          );

          // var placeholder = $(this).text();
          // $current.prepend($('<span>', {
          //   class: $current.attr('class').replace(/sel/g, 'sel__placeholder'),
          //   text: placeholder,
          //   'data-placeholder': placeholder
          // }));

          return;
        }
        if ($current.hasClass("redirect-drowpdown")) {
          $current.children("div").append(
            $("<span >", {
              class: $current
                .attr("class")
                .replace(/sel/g, "sel__box__options"),
              id: $(this).val(),
              text: $(this).text(),
            })
          );
        } else {
          $current.children("div").append(
            $("<span>", {
              class: $current
                .attr("class")
                .replace(/sel/g, "sel__box__options"),
              text: $(this).text(),
            })
          );
        }
      });
  });

  $(".sel").click(function () {
    $(this).toggleClass("active");
  });

  // Toggling the `.selected` state on the options.
  $(".sel__box__options").click(function () {
    var txt = $(this).text();
    var index = $(this).index();

    $(this).siblings(".sel__box__options").removeClass("selected");
    $(this).addClass("selected");

    var $currentSel = $(this).closest(".sel");
    $currentSel.children(".sel__placeholder").text(txt);
    $currentSel.children("select").prop("selectedIndex", index + 1);
    $currentSel.find(".sel__placeholder").attr("data-placeholder", txt);
    $currentSel.find("#propiedad_val").attr("value", txt);

    if ($currentSel.hasClass("redirect-drowpdown")) {
      window.location.href = $(this).attr("id");
    }
    url = '';
    if ($currentSel.hasClass("filter-drowpdown")) {
      var txt = txt.toString().toLowerCase().trim();


      switch (txt) {
        case "más reciente":
          url = $("#mas-reciente").val();
          break;

        case "más antiguos":

          url = $("#mas-antiguos").val();
          break;

        case "menor precio":
          url = $("#menor-precio").val();
          break;

        case "mayor precio":
          url = $("#mayor-precio").val();
          break;

        case "más pequeños":
          url = $("#menor-superficie").val();
          break;

        case "más amplios":
          url = $("#mayor-superficie").val();
          break;

        default:
          break;
      }
      addLoader($currentSel);

      $("#resultados_propiedades .content-order > div > span").hide();
      if (!url.endsWith("/")) {
        url = url + "/";
      }
      window.location.href = "/listado/" + url;
    }
  });

  // Scroll animation
  $(window).scroll(function () {
    if ($(window).scrollTop() >= 60) {
      $("header, #nav-mobile").addClass("scroll", 250);
      $("header.header_v2 .logo").attr(
        "src",
         "/img/logo.png"
      );
    } else {
      $("header, #nav-mobile ").removeClass("scroll", 250);
      $("header.header_v2 .logo").attr(
        "src",
         "/img/logo_black.png"
      );
    }
  });

  //target-burger-click
  $("a.target-burger").click(function (e) {
    var nav_mobile = $(
      "#container-main, nav.main-nav, a.target-burger, #nav-mobile"
    );

