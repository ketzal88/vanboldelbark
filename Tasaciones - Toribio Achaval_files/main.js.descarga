  //Aplicar precio
  $("#aplicar_precio").click(function (event) {
    event.preventDefault();
    var pattern = $(this).closest(".filter-precio");
    var desde = pattern.find("#desde_precio").val();
    var hasta = pattern.find("#hasta_precio").val();
    var moneda = pattern.find("input[name=radioButton]:checked").val();


    var btn = $(this);

    if (desde == "") {
      pattern.find("#desde_precio").addClass("error_1");
      setTimeout(function () {
        pattern.find("#desde_precio").removeClass("error_1");
      }, 2000);
      return false;
    }

    if (hasta == "") {
      pattern.find("#hasta_precio").addClass("error_1");
      setTimeout(function () {
        pattern.find("#hasta_precio").removeClass("error_1");
      }, 2000);
      return false;
    }

    if (parseInt(hasta) < parseInt(desde)) {
      pattern.find("#hasta_precio").addClass("error_1");
      setTimeout(function () {
        pattern.find("#hasta_precio").removeClass("error_1");
      }, 2000);
      return false;
    }

    var string_precio = desde + "-" + hasta + "-" + moneda + "-" ;
    var urlstring = window.location.href;
    urlstring = urlstring.replace("#0", "");
    urlstring = urlstring.replace(/\/precio_(\d|-|[A-Z])*/, "");
    //  console.log(string_precio)
