  $(".open-exit-modal").click(function (e) {
    var plat = $(this).data("plat");
    var url = $(this).data("url");
    $("#modal-exit #plat").html(plat);
    $("#modal-exit #url-exit").attr("href", url);
    $("#modal-exit").removeClass("closed");
    $("#modal-overlay").removeClass("closed");
  });
  $("#modal-overlay").click(function (e) {
    $(".modal").addClass("closed");
    $("#modal-overlay").addClass("closed");
  });
  $("#cancel-popup-whatsapp").click(function (e) {
    $(".modal").addClass("closed");

    $("#modal-overlay").addClass("closed");
