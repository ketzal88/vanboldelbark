  //banner fadein fadeout

  $("#banner input[name=propiedad]").change(function () {
    var current = $("#banner .img-bg.active");
    var id = $(this).attr("id");

    $("#banner img[data-propiedad=" + id + "]").addClass("active");
    current.removeClass("active");
