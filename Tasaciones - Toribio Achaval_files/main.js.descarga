  //media query

  if (window.matchMedia("(max-width: 940px)").matches) {
    //scroll mobile
    $("#filters .data-main").mCustomScrollbar({
      axis: "y",
      theme: "dark",
    });
  }
});

function getNamePropiedadById(data) {
  var data_ = data.toString().toLowerCase();
  switch (data_) {
    case "casas":
      $tipo_propiedad = "1";
      break;

    case "departamentos":
      $tipo_propiedad = "4";
      break;
    case "ph":
      $tipo_propiedad = "40";
      break;

    case "oficinas":
      $tipo_propiedad = "24";
      break;

    case "edificios en block":
      $tipo_propiedad = "21";
      break;
    case "hoteles":
      $tipo_propiedad = "41";
      break;

    case "emprendimientos":
      $tipo_propiedad = "e";
      break;

    case "locales":
      $tipo_propiedad = "10";
      break;

    case "terrenos":
      $tipo_propiedad = "29";
      break;

    case "lotes":
      $tipo_propiedad = "8";
      break;

    case "depósitos":
      $tipo_propiedad = "18";
      break;

    default:
      $tipo_propiedad = "0";
      break;
  }

  return $tipo_propiedad;
}

function searchPropiedades(data) {
  var pattern = $(data).closest(".form-search");
  var ar_params = new Array();

/*
  var tipo_propiedad = pattern.find("input[name=propiedad]:checked").val();
  */
  var tipo_propiedad =pattern.find( 'select[name=select-tipopropiedad]' ).val();
  //var tipo_propiedad = pattern.find( 'input[name=propiedad]:checked' ).val();

  if (tipo_propiedad != "") {
    ar_params.push(tipo_propiedad);
  }

  var comprar_alquilar = pattern
    .find("input[name=comprar_alquilar]:checked")
    .val();


  var estado = true;
  var autocomplete = $("#autocomplete-val").val();

  var btn = pattern.find(".search_propiedades");
  var quicksearch = '';
  if (window.matchMedia("(max-width: 767px)").matches) {
   // quicksearch = pattern.find(".mobile_767 .quicksearch").val()??'';
    quicksearch = pattern.find(".quicksearch_mobile").val()??'';
    comprar_alquilar = $("#comprar_alquilar_mobile").val();
    var btn = pattern.find(".mobile_767 .search_propiedades");
  } else {
    quicksearch = pattern.find(".desktop_767 .quicksearch").val()??'';
    var btn = pattern.find(".desktop_767 .search_propiedades");
  }
  if (comprar_alquilar != "" && tipo_propiedad != "emprendimientos") {
    ar_params.push(comprar_alquilar);
  }
  /*    if(tipo_propiedad == 'e'){
        estado = 'estado_publicacion=1'
    }else{
        estado = 'estados_publicacion=1'
    }*/
  utmvalue = $("#utmvalues").val() ?? "";
  addLoader(btn);

  if (autocomplete == "" || autocomplete.indexOf('C') == 0) {
    if (quicksearch != "") {
      quicksearch = quicksearch.replace('Emprendimiento, ', "");
      ar_params.push("quicksearch_" + quicksearch.replace(/\s/g, "_"));
    } else {
      if (tipo_propiedad == "departamentos" && comprar_alquilar == "venta") {
        ar_params.push("capital-federal");
      }
      if (tipo_propiedad == "ph" && comprar_alquilar == "venta") {
        ar_params.push("capital-federal");
      }
      if (tipo_propiedad == "locales") {
        ar_params.push("capital-federal");
      }
      if (tipo_propiedad == "terrenos" && comprar_alquilar == "venta") {
        ar_params.push("capital-federal");
      }
    }

    //ar_params.push("view_list");
    window.location = "/listado/" + ar_params.join("/") + "/" + utmvalue;
  } else {
    var id = autocomplete.split("|");
    tipo_busqueda = "ubicacion";
    if (id[0] == "P") {
      tipo_busqueda = "pais";
    } else if (id[0] == "R") {
      tipo_busqueda = "provincia";
    } else if (id[0] == "L") {
      tipo_busqueda = "localidad";
    } else if (id[0] == "B") {
      tipo_busqueda = "barrio";
    } else if (id[0] == "Z") {
      tipo_busqueda = "barrio";
    }
    if (id[2] != "") {
      ar_params.push(id[2]);
    }

    //ar_params.push("view_list");
    window.location = "/listado/" + ar_params.join("/") + "/" + utmvalue;
  }
}

function searchPropiedadesV2(data) {
  var pattern = $(data).closest(".search-content");
  var comprar_alquilar = pattern
    .find("input[name=comprar_alquilar]:checked")
    .val();
  var tipo_propiedad = $("#select-prop").val();
  var autocomplete = $("#autocomplete-val").val();

  var ar_params = new Array();

  if (tipo_propiedad != "") {
    ar_params.push(tipo_propiedad);
  }
  if (comprar_alquilar != "" && tipo_propiedad != "emprendimientos") {
    ar_params.push(comprar_alquilar);
  }

  if (window.matchMedia("(max-width: 767px)").matches) {
    var quicksearch = pattern.find(".mobile_767 .quicksearch").val();
    var btn = pattern.find(".mobile_767 .search_propiedades_v2");
  } else {
    var quicksearch = pattern.find(".desktop_767 .quicksearch").val();
    var btn = pattern.find(".desktop_767 .search_propiedades_v2");
  }

  /*if( $('#url_querystring').length > 0){
        var url_querystring = $('#url_querystring').val()
    }else{
        var url_querystring = '?view=list&tipo_operacion=2&producto=4&quicksearch=&estados_publicacion=1';
    }

    var url = QuerystringToJSON(url_querystring);*/
  var url_querystring = $("#url_querystring").val();
  var ar_url = new Array();
  if (url_querystring != undefined) {
    ar_url = url_querystring.split("/");
  }

  /* Si es una busqueda por autocomplete */
  if (autocomplete != "") {
    var id = autocomplete.split("|");

    if (id[2] != "") {
      ar_params.push(id[2]);
    }
  } else {
    if (quicksearch != ""  || autocomplete.indexOf('C') == 0) {
      quicksearch = quicksearch.replace('Emprendimiento, ', "");
      ar_params.push("quicksearch_" + quicksearch.replace(/\s/g, "_"));
    } else {
      if (tipo_propiedad == "departamentos" && comprar_alquilar == "venta") {
        ar_params.push("capital-federal");
      }
      if (tipo_propiedad == "ph" && comprar_alquilar == "venta") {
        ar_params.push("capital-federal");
      }
      if (tipo_propiedad == "locales") {
        ar_params.push("capital-federal");
      }
      if (tipo_propiedad == "terrenos" && comprar_alquilar == "venta") {
        ar_params.push("capital-federal");
      }
    }
  }

  if (ar_url["view_list"] !== undefined) {
    //   ar_params.push("view_list");
  } else if (ar_url["view_grid"] !== undefined) {
    ar_params.push("view_grid");
  } else if (ar_url["view_map"] !== undefined) {
    ar_params.push("view_map");
  }

  addLoader(btn);

  utmvalue = $("#utmvalues").val() ?? "";
  //  ar_params.push("view_list");
  //  console.log(ar_params);
  window.location = "/listado/" + ar_params.join("/") + "/" + utmvalue;
}

function PlaceholderPropiedad(tipo_propiedad_id) {
    if (tipo_propiedad_id == 1 || tipo_propiedad_id == 4) {
        return "/img/propiedades/casas_deptos_nofoto.jpg";
    }
    else if (tipo_propiedad_id == 29  || tipo_propiedad_id == 30) {
        return "/img/propiedades/casas_deptos_nofoto.jpg";
    }
    else if (tipo_propiedad_id == 24) {
        return "/img/propiedades/oficina_nofoto.jpg";
    }
    else if (tipo_propiedad_id == 10) {
        return "/img/propiedades/locales_nofoto.jpg";
    }
    else {
        return "/img/propiedades/generica_nofoto.jpg";
    }
}


function QuerystringToJSON(queryString) {
  var j, q;
  q = queryString.toString().replace(/\?/, "").split("&");
  j = {};
  $.each(q, function (i, arr) {
    arr = arr.split("=");
    return (j[arr[0]] = arr[1]);
  });
  return j;
}

function JSONtoQuerystring(queryString) {
  queryStringurl = Object.keys(queryString)
    .map(function (k) {
      if (!k.match(/[0-9]+$/)) {
        return encodeURIComponent(k) + "=" + encodeURIComponent(queryString[k]);
      }
    })
    .join("&");

  return queryStringurl;
}

function parseUrlAPI(url) {
  url = url.replace("&pg=", "&page=");
  url = url.replace("&tipo_operacion=6", "&tipo_operacion=6a");
  url = url.replace("&max_per_page=20", "&max_per_page=21");
  return url;
}

function addLoader(btn) {
  btn.css({
    width: btn.outerWidth(),
    height: btn.outerHeight(),
  });
  btn.addClass("sending");
  btn.html('<div class="lds-dual-ring"></div>');
}

function addLoaderEnd(btn) {
  btn.removeClass("sending");
  btn.html("Enviar");
}

function echeck(str) {
  if (/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/.test(str)) {
    return true;
  }
