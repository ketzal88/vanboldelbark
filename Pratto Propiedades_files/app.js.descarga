$(document).ready(function () {

  $('#enviar_form').click(function(e) {
    e.preventDefault();
    
   
    var name = $("#form_name").val();
    var email = $("#form_email").val();
    var message = $("#comentarios").val();
    var dataString = 'nombre=' + name + '&email=' + email + '&comentarios=' + message;


    function isValidEmail(emailAddress) {
			var pattern = new RegExp(/^((([a-z]|\d|[!#\$%&'\*\+\-\/=\?\^_`{\|}~]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+(\.([a-z]|\d|[!#\$%&'\*\+\-\/=\?\^_`{\|}~]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])+)*)|((\x22)((((\x20|\x09)*(\x0d\x0a))?(\x20|\x09)+)?(([\x01-\x08\x0b\x0c\x0e-\x1f\x7f]|\x21|[\x23-\x5b]|[\x5d-\x7e]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])|(\\([\x01-\x09\x0b\x0c\x0d-\x7f]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF]))))*(((\x20|\x09)*(\x0d\x0a))?(\x20|\x09)+)?(\x22)))@((([a-z]|\d|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])|(([a-z]|\d|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])([a-z]|\d|-|\.|_|~|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])*([a-z]|\d|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])))\.)+(([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])|(([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])([a-z]|\d|-|\.|_|~|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])*([a-z]|[\u00A0-\uD7FF\uF900-\uFDCF\uFDF0-\uFFEF])))\.?$/i);
			return pattern.test(emailAddress);
		};

    if (isValidEmail(email) && (message.length > 5) && (name.length > 1)){
      $.ajax({
        type: "POST",
        url: "send_popup.php",
        data: $('#formPopUp').serialize(),
        dataType: "json",
        cache: false,
        beforeSend: function (data) {
          $(".response").addClass('success').html('Enviando datos');
        },
        success: function (data) {
          $('.response').addClass('success').text('' + data.content + '');
          $('#formPopUp')[0].reset();
         
          $('#enviar_form').addClass('ok');
          $('#enviar_form').html('<span class="fa fa-check"></span>');
          $('#enviar_form').removeClass('alert');
         
          $('#myModal').delay(3000).fadeOut(1000);
          
        },
        error: function (data) {
          $('#enviar_form').removeClass('ok');
          $('#enviar_form').html('volver a enviar');
          $('.response').text('Ha ocurrido un Error');

        }
      });
    
    } else {
      $(".response").html('<div class="warning"> (*) Debe completar todos los campos </div>');
     
    }

    

  });
});